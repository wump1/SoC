# Generated build artifacts (regenerate via `make`; see Makefile).
/build/
/fpga/build/*
!/fpga/build/.gitkeep

# Simulation / toolchain outputs that may land next to sources during
# ad-hoc runs.
*.vvp
*.vcd
*.fst
*.elf
*.o
*.dump
*.hex
*.bin

# Synthesis / PnR intermediates. The full raw logs are regenerable via
# `make synth`/`synth-soc-smoketest`/`pnr`/`timing`/`bitstream`; the curated,
# permanent record of what they produced lives in docs/results/ instead.
synth/*.json
synth/*.log
synth/reports/
*.asc
*.bit

__pycache__/
*.pyc
